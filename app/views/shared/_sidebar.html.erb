<aside
  data-sidebar-target="sidebar"
  data-sidebar-collapsed-class="md:w-16"
  data-sidebar-expanded-class="md:w-60"
  role="navigation"
  aria-label="Navegación principal"
  class="fixed inset-y-0 left-0 z-40 flex h-screen w-60 -translate-x-full flex-col border-r border-border bg-card transition-all duration-300 md:static md:z-auto md:translate-x-0 md:w-60 print:hidden"
>
  <%# Logo section %>
  <div class="flex items-center gap-2 border-b border-border px-4 py-4">
    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary">
      <%= icon("activity", classes: "h-4 w-4 text-primary-foreground") %>
    </div>
    <div class="overflow-hidden" data-sidebar-target="label">
      <h1 class="text-sm font-semibold text-foreground truncate">LIDR RAG Estimator</h1>
      <p class="text-[10px] text-muted-foreground font-mono">v1.0.0</p>
    </div>
  </div>

  <%# Navigation %>
  <nav class="flex-1 space-y-1 px-2 py-3">
    <%
      nav_items = [
        { path: dashboard_path, icon: "layout_dashboard", label: "Dashboard" },
        { path: ingest_path, icon: "upload", label: "Ingesta" },
        { path: estimate_path, icon: "brain", label: "Estimación" },
        { path: search_path, icon: "search", label: "Búsqueda" },
        { path: documents_path, icon: "file_text", label: "Estimaciones" },
      ]
    %>

    <% nav_items.each do |item| %>
      <%
        is_active = current_page?(item[:path]) || (item[:path] == documents_path && controller_name == "documents")
        link_classes = if is_active
          "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors bg-primary/10 text-primary glow-sm"
        else
          "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-muted-foreground hover:bg-surface-hover hover:text-foreground"
        end
      %>
      <%= link_to item[:path], class: link_classes, "aria-current": (is_active ? "page" : nil), data: { action: "click->sidebar#closeMobile" } do %>
        <%= icon(item[:icon], classes: "h-4 w-4 shrink-0") %>
        <span data-sidebar-target="label"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>

  <%# Collapse toggle (desktop only) %>
  <div class="border-t border-border p-2 hidden md:block">
    <button
      data-action="sidebar#toggle"
      aria-label="Colapsar menú lateral"
      aria-expanded="true"
      data-sidebar-target="toggleBtn"
      class="flex w-full items-center justify-center rounded-lg p-2 text-muted-foreground hover:bg-surface-hover hover:text-foreground transition-colors"
    >
      <span data-sidebar-target="collapseIcon">
        <%= icon("chevron_left", classes: "h-4 w-4") %>
      </span>
      <span data-sidebar-target="expandIcon" class="hidden">
        <%= icon("chevron_right", classes: "h-4 w-4") %>
      </span>
    </button>
  </div>
</aside>
