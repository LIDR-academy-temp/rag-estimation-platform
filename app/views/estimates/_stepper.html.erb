<%# locals: (current_step:) %>
<%
  steps = [
    { icon: "file_text", label: "Transcripciones" },
    { icon: "brain", label: "Bloques y tareas" },
    { icon: "clock", label: "Estimacion" }
  ]
%>
<div class="mb-8 flex items-center justify-center gap-2">
  <% steps.each_with_index do |step, i| %>
    <% if i > 0 %>
      <div class="h-px w-8 sm:w-16 <%= i <= current_step ? 'bg-primary' : 'bg-border' %>"></div>
    <% end %>
    <%
      if i < current_step
        cls = "bg-primary/20 text-primary"
      elsif i == current_step
        cls = "bg-primary text-primary-foreground"
      else
        cls = "bg-surface text-muted-foreground"
      end
    %>
    <div class="flex items-center gap-2 rounded-full px-4 py-2 text-xs font-medium <%= cls %>">
      <%= icon(step[:icon], classes: "h-3.5 w-3.5") %>
      <span class="hidden sm:inline"><%= step[:label] %></span>
    </div>
  <% end %>
</div>
