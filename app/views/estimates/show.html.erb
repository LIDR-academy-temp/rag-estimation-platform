<% content_for :page_actions do %>
  <% if @estimation.status == "completed" %>
    <%= link_to export_estimate_pdf_path(@estimation),
      target: "_blank",
      class: "inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-9 px-3 hover:bg-primary/90 transition-colors print:hidden" do %>
      <%= icon("file_text", classes: "mr-2 h-4 w-4") %> Exportar PDF
    <% end %>
    <%= link_to export_estimate_json_path(@estimation),
      class: "inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-9 px-3 hover:bg-primary/90 transition-colors print:hidden" do %>
      <%= icon("file_json", classes: "mr-2 h-4 w-4") %> Exportar JSON
    <% end %>
  <% end %>
  <%= link_to estimations_path, class: "inline-flex items-center justify-center rounded-md border border-border bg-card text-sm font-medium h-9 px-3 hover:bg-surface-hover transition-colors print:hidden" do %>
    <%= icon("arrow_left", classes: "mr-2 h-4 w-4") %> Volver
  <% end %>
<% end %>

<%= render "shared/page_header", title: @estimation.title, description: @estimation.description %>

<%# Print header %>
<div class="hidden print:block mb-6 border-b border-gray-300 pb-4">
  <h1 class="text-xl font-bold"><%= @estimation.title %></h1>
  <p class="text-sm text-gray-600">Generado el <%= @estimation.created_at.strftime("%d/%m/%Y %H:%M") %></p>
</div>

<%= turbo_stream_from "estimation_#{@estimation.id}" %>

<%# Stepper %>
<%
  current_step = case @estimation.status
  when "processing", "structuring" then 1
  when "completed" then 2
  else 0
  end
%>
<%= tag.div id: "estimation_#{@estimation.id}_stepper" do %>
  <%= render "estimates/stepper", current_step: current_step %>
<% end %>

<%= tag.div id: "estimation_#{@estimation.id}_content" do %>
  <%= render "estimates/estimation_content", estimation: @estimation %>
<% end %>
