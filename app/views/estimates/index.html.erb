<%= render "shared/page_header", title: "Generar estimación", description: "Analiza reuniones con cliente para generar estimaciones basadas en datos históricos" %>

<%# Stepper %>
<div class="mb-8 flex items-center justify-center gap-2" data-controller="wizard">
  <%
    steps = [
      { label: "Transcripciones", icon: "file_text" },
      { label: "Bloques y tareas", icon: "brain" },
      { label: "Estimación", icon: "clock" }
    ]
  %>
  <% steps.each_with_index do |step, i| %>
    <% if i > 0 %>
      <div class="h-px w-8 sm:w-16 transition-colors bg-border" data-wizard-target="connector"></div>
    <% end %>
    <div
      class="flex items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all <%= i == 0 ? 'bg-primary text-primary-foreground' : 'bg-surface text-muted-foreground' %>"
      data-wizard-target="step"
    >
      <%= icon(step[:icon], classes: "h-3.5 w-3.5") %>
      <span class="hidden sm:inline"><%= step[:label] %></span>
    </div>
  <% end %>

  <%# Step panels %>
  <%# Step 1: Transcriptions %>
  <div class="hidden" data-wizard-target="panel" data-wizard-index="0" style="display: block;">
  </div>
</div>

<%# Step 1: Transcriptions (default visible) %>
<div data-wizard-target="panel" data-wizard-index="0">
  <div class="space-y-5">
    <%# Paste area %>
    <div class="rounded-xl border border-border bg-card p-5">
      <h3 class="text-sm font-semibold text-card-foreground mb-3">
        Pegar transcripción de reunión
      </h3>
      <textarea
        placeholder="Pega aquí la transcripción de una reunión con el cliente..."
        class="flex min-h-[140px] w-full rounded-md border border-border bg-surface px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary resize-none"
      ></textarea>
      <div class="mt-3 flex items-center gap-3">
        <button class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-9 px-3 hover:bg-primary/90 transition-colors opacity-50 cursor-not-allowed" disabled>
          <%= icon("plus", classes: "mr-1.5 h-3.5 w-3.5") %>
          Añadir reunión
        </button>
        <span class="text-xs text-muted-foreground">o</span>
        <button class="inline-flex items-center justify-center rounded-md border border-border bg-card text-sm font-medium h-9 px-3 hover:bg-surface-hover transition-colors">
          <%= icon("upload", classes: "mr-1.5 h-3.5 w-3.5") %>
          Subir archivo .txt
        </button>
      </div>
    </div>

    <%# Actions %>
    <div class="flex justify-end">
      <button class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-10 px-4 hover:bg-primary/90 transition-colors opacity-50 cursor-not-allowed" disabled>
        <%= icon("brain", classes: "mr-2 h-4 w-4") %>
        Analizar transcripciones
        <%= icon("arrow_right", classes: "ml-2 h-4 w-4") %>
      </button>
    </div>
  </div>
</div>

<%# Step 2: Blocks & Tasks (hidden placeholder) %>
<div data-wizard-target="panel" data-wizard-index="1" style="display: none;">
  <div class="space-y-5">
    <div class="rounded-xl border border-primary/30 bg-card p-4 glow-sm flex items-center gap-3">
      <%= icon("sparkles", classes: "h-4 w-4 text-primary shrink-0") %>
      <p class="text-sm text-card-foreground">
        Funcionalidad disponible tras analizar transcripciones en el Paso 1.
      </p>
    </div>
  </div>
</div>

<%# Step 3: Estimation results (hidden placeholder) %>
<div data-wizard-target="panel" data-wizard-index="2" style="display: none;">
  <div class="space-y-5">
    <div class="rounded-xl border border-border bg-card p-12 flex flex-col items-center justify-center gap-4">
      <%= icon("clock", classes: "h-8 w-8 text-muted-foreground") %>
      <p class="text-sm text-muted-foreground">
        Los resultados de estimación aparecerán aquí una vez completado el análisis.
      </p>
    </div>
  </div>
</div>
