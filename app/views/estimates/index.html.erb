<%= render "shared/page_header", title: "Generar estimación", description: "Analiza reuniones con cliente para generar estimaciones basadas en datos históricos" %>

<%= render "estimates/stepper", current_step: 0 %>

<%= form_with url: estimates_path, method: :post, data: { controller: "transcription" } do |f| %>
  <div class="space-y-5">
    <%# Project config (collapsible) %>
    <details open class="rounded-xl border border-border bg-card group">
      <summary class="px-5 py-3 cursor-pointer text-sm font-semibold text-card-foreground flex items-center justify-between">
        <span class="flex items-center gap-2">
          <%= icon("sliders_horizontal", classes: "h-3.5 w-3.5 text-muted-foreground") %>
          Configuración del proyecto
        </span>
        <%= icon("chevron_down", classes: "h-4 w-4 text-muted-foreground transition-transform group-open:rotate-180") %>
      </summary>
      <div class="border-t border-border px-5 py-4 space-y-4">
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-1">Título</label>
          <input type="text" name="estimation[title]" value="Estimacion <%= Date.current %>"
            class="flex h-9 w-full rounded-md border border-border bg-surface px-3 py-1 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1">Tarifa global (€/h)</label>
            <input type="number" name="estimation[global_rate]" value="150" min="1"
              class="flex h-9 w-full rounded-md border border-border bg-surface px-3 py-1 text-sm font-mono placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />
          </div>
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1">Moneda</label>
            <select name="estimation[currency]"
              class="flex h-9 w-full rounded-md border border-border bg-surface px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary">
              <option value="EUR" selected>EUR (€)</option>
              <option value="USD">USD ($)</option>
              <option value="GBP">GBP (£)</option>
            </select>
          </div>
        </div>

        <%# Stack preferences %>
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-2">Frontend</label>
          <div class="flex flex-wrap gap-2">
            <% Estimation::FRONTEND_OPTIONS.each do |tech| %>
              <label class="cursor-pointer">
                <input type="checkbox" name="estimation[frontend_stack][]" value="<%= tech %>" class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground transition-colors peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary hover:bg-surface-hover">
                  <%= tech %>
                </span>
              </label>
            <% end %>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-muted-foreground mb-2">Backend</label>
          <div class="flex flex-wrap gap-2">
            <% Estimation::BACKEND_OPTIONS.each do |tech| %>
              <label class="cursor-pointer">
                <input type="checkbox" name="estimation[backend_stack][]" value="<%= tech %>" class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground transition-colors peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary hover:bg-surface-hover">
                  <%= tech %>
                </span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </details>

    <%# Transcription input card %>
    <div class="rounded-xl border border-border bg-card p-5">
      <h3 class="text-sm font-semibold text-card-foreground mb-3">
        Pegar transcripción de reunión
      </h3>
      <textarea
        data-transcription-target="input"
        data-action="input->transcription#inputChanged"
        placeholder="Pega aquí la transcripción de una reunión con el cliente..."
        class="flex min-h-[140px] w-full rounded-md border border-border bg-surface px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary resize-none"
      ></textarea>
      <div class="mt-3 flex items-center gap-3">
        <button type="button"
          data-transcription-target="addBtn"
          data-action="click->transcription#add"
          class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-9 px-3 hover:bg-primary/90 transition-colors opacity-50 cursor-not-allowed"
          disabled>
          <%= icon("plus", classes: "mr-1.5 h-3.5 w-3.5") %>
          Añadir reunión
        </button>
        <span class="text-xs text-muted-foreground">o</span>
        <button type="button"
          data-action="click->transcription#uploadFile"
          class="inline-flex items-center justify-center rounded-md border border-border bg-card text-sm font-medium h-9 px-3 hover:bg-surface-hover transition-colors">
          <%= icon("upload", classes: "mr-1.5 h-3.5 w-3.5") %>
          Subir archivo .txt
        </button>
        <input type="file" accept=".txt" class="hidden"
          data-transcription-target="fileInput"
          data-action="change->transcription#fileSelected" />
      </div>
    </div>

    <%# Transcription list (hidden until items exist) %>
    <div data-transcription-target="listSection" class="hidden">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-sm font-semibold text-card-foreground">Transcripciones añadidas</h4>
        <span data-transcription-target="counter" class="text-xs text-muted-foreground">0 transcripciones</span>
      </div>
      <div data-transcription-target="list" class="space-y-2">
      </div>
    </div>

    <%# Template for transcription items %>
    <template data-transcription-target="template">
      <div data-transcription-item class="rounded-lg border border-border bg-surface px-4 py-3 flex items-start gap-3 animate-fade-in-up">
        <div class="shrink-0 mt-0.5 text-primary">
          <%= icon("file_text", classes: "h-4 w-4") %>
        </div>
        <div class="min-w-0 flex-1">
          <p data-name class="text-sm font-medium text-card-foreground"></p>
          <p data-preview class="text-xs text-muted-foreground mt-0.5 truncate"></p>
          <input type="hidden" name="estimation[raw_transcriptions][]" />
        </div>
        <button type="button" data-action="click->transcription#remove"
          class="shrink-0 rounded p-1 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors">
          <%= icon("trash2", classes: "h-3.5 w-3.5") %>
        </button>
      </div>
    </template>

    <%# Submit %>
    <div class="flex justify-end">
      <button type="submit"
        data-transcription-target="submitBtn"
        class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-10 px-4 hover:bg-primary/90 transition-colors opacity-50 cursor-not-allowed"
        disabled>
        <%= icon("brain", classes: "mr-2 h-4 w-4") %>
        Analizar transcripciones
        <%= icon("arrow_right", classes: "ml-2 h-4 w-4") %>
      </button>
    </div>
  </div>
<% end %>
