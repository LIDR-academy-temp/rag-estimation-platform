<%# locals: (estimation:) %>
<%
  blocks = estimation.functional_blocks.includes(:tasks)
  total_tasks = blocks.sum { |b| b.tasks.size }
%>

<%= form_with model: estimation, url: update_estimate_structure_path(estimation), method: :patch, data: { controller: "nested-form" } do |f| %>
  <div class="space-y-5">
    <%# Summary bar %>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="flex items-center gap-3">
        <%= icon("brain", classes: "h-5 w-5 text-primary") %>
        <p class="text-sm text-card-foreground">
          Se han identificado
          <span class="font-semibold" data-nested-form-target="blockCount"><%= blocks.size %></span> bloques funcionales y
          <span class="font-semibold" data-nested-form-target="taskCount"><%= total_tasks %></span> tareas
        </p>
      </div>
    </div>

    <%# Blocks container %>
    <div data-nested-form-target="blocksContainer" class="space-y-4">
      <% blocks.each_with_index do |block, bi| %>
        <div class="rounded-xl border border-border bg-card overflow-hidden" data-nested-form-target="blockEntry" data-collapsible-target="block">
          <div class="flex items-center gap-2 px-5 py-3.5 bg-surface/50">
            <button type="button" class="text-muted-foreground hover:text-card-foreground transition-colors" data-action="collapsible#toggle" aria-expanded="true">
              <span data-collapsible-target="iconExpanded"><%= icon("chevron_down", classes: "h-4 w-4") %></span>
              <span data-collapsible-target="iconCollapsed" class="hidden"><%= icon("chevron_right", classes: "h-4 w-4") %></span>
            </button>

            <input type="hidden" name="estimation[functional_blocks_attributes][<%= bi %>][id]" value="<%= block.id %>" />
            <input type="text"
              name="estimation[functional_blocks_attributes][<%= bi %>][name]"
              value="<%= block.name %>"
              class="flex-1 h-8 rounded-md border border-border bg-surface px-3 text-sm font-semibold text-card-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />

            <span class="text-xs text-muted-foreground font-mono" data-nested-form-target="blockTaskCount"><%= block.tasks.size %> tareas</span>

            <button type="button" data-action="nested-form#removeBlock" class="rounded p-1 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors">
              <%= icon("trash2", classes: "h-4 w-4") %>
            </button>
          </div>

          <div class="px-5 py-3 space-y-2" data-collapsible-target="body">
            <div data-nested-form-target="tasksContainer" class="space-y-2">
              <% block.tasks.each_with_index do |task, ti| %>
                <div class="flex items-center gap-3 rounded-lg bg-surface px-4 py-2.5" data-nested-form-target="taskEntry">
                  <%= icon("grip_vertical", classes: "h-3.5 w-3.5 text-muted-foreground") %>
                  <input type="hidden" name="estimation[functional_blocks_attributes][<%= bi %>][tasks_attributes][<%= ti %>][id]" value="<%= task.id %>" />
                  <input type="text"
                    name="estimation[functional_blocks_attributes][<%= bi %>][tasks_attributes][<%= ti %>][name]"
                    value="<%= task.name %>"
                    class="flex-1 h-8 rounded-md border border-border bg-card px-3 text-sm text-card-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />
                  <button type="button" data-action="nested-form#removeTask" class="rounded p-1 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors">
                    <%= icon("trash2", classes: "h-3.5 w-3.5") %>
                  </button>
                </div>
              <% end %>
            </div>

            <%# Add task button %>
            <button type="button"
              data-action="nested-form#addTask"
              data-block-index="<%= bi %>"
              class="flex w-full items-center justify-center gap-2 rounded-lg border border-dashed border-border px-4 py-2.5 text-sm text-muted-foreground hover:border-primary hover:text-primary transition-colors">
              <%= icon("plus", classes: "h-3.5 w-3.5") %>
              Anadir tarea
            </button>
          </div>
        </div>
      <% end %>
    </div>

    <%# Add block button %>
    <button type="button"
      data-action="nested-form#addBlock"
      class="flex w-full items-center justify-center gap-2 rounded-xl border border-dashed border-border px-5 py-4 text-sm text-muted-foreground hover:border-primary hover:text-primary transition-colors">
      <%= icon("plus", classes: "h-4 w-4") %>
      Anadir bloque funcional
    </button>

    <%# Navigation %>
    <div class="flex items-center justify-between pt-2">
      <%= link_to estimate_detail_path(estimation), class: "inline-flex items-center justify-center rounded-md border border-border bg-card text-sm font-medium h-10 px-4 hover:bg-surface-hover transition-colors" do %>
        <%= icon("arrow_left", classes: "mr-2 h-4 w-4") %>
        Volver
      <% end %>
      <button type="submit" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-10 px-4 hover:bg-primary/90 transition-colors">
        <%= icon("clock", classes: "mr-2 h-4 w-4") %>
        Estimar tiempos
        <%= icon("arrow_right", classes: "ml-2 h-4 w-4") %>
      </button>
    </div>
  </div>

  <%# Template for new block %>
  <template data-nested-form-target="blockTemplate">
    <div class="rounded-xl border border-border bg-card overflow-hidden" data-nested-form-target="blockEntry" data-collapsible-target="block">
      <div class="flex items-center gap-2 px-5 py-3.5 bg-surface/50">
        <button type="button" class="text-muted-foreground hover:text-card-foreground transition-colors" data-action="collapsible#toggle" aria-expanded="true">
          <span data-collapsible-target="iconExpanded"><%= icon("chevron_down", classes: "h-4 w-4") %></span>
          <span data-collapsible-target="iconCollapsed" class="hidden"><%= icon("chevron_right", classes: "h-4 w-4") %></span>
        </button>

        <input type="text"
          name="estimation[functional_blocks_attributes][NEW_BLOCK_RECORD][name]"
          value=""
          placeholder="Nombre del bloque"
          class="flex-1 h-8 rounded-md border border-border bg-surface px-3 text-sm font-semibold text-card-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />

        <span class="text-xs text-muted-foreground font-mono" data-nested-form-target="blockTaskCount">0 tareas</span>

        <button type="button" data-action="nested-form#removeBlock" class="rounded p-1 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors">
          <%= icon("trash2", classes: "h-4 w-4") %>
        </button>
      </div>

      <div class="px-5 py-3 space-y-2" data-collapsible-target="body">
        <div data-nested-form-target="tasksContainer" class="space-y-2">
        </div>

        <button type="button"
          data-action="nested-form#addTask"
          data-block-index="NEW_BLOCK_RECORD"
          class="flex w-full items-center justify-center gap-2 rounded-lg border border-dashed border-border px-4 py-2.5 text-sm text-muted-foreground hover:border-primary hover:text-primary transition-colors">
          <%= icon("plus", classes: "h-3.5 w-3.5") %>
          Anadir tarea
        </button>
      </div>
    </div>
  </template>

  <%# Template for new task %>
  <template data-nested-form-target="taskTemplate">
    <div class="flex items-center gap-3 rounded-lg bg-surface px-4 py-2.5" data-nested-form-target="taskEntry">
      <%= icon("grip_vertical", classes: "h-3.5 w-3.5 text-muted-foreground") %>
      <input type="text"
        name="estimation[functional_blocks_attributes][BLOCK_INDEX][tasks_attributes][NEW_TASK_RECORD][name]"
        value=""
        placeholder="Nombre de la tarea"
        class="flex-1 h-8 rounded-md border border-border bg-card px-3 text-sm text-card-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary" />
      <button type="button" data-action="nested-form#removeTask" class="rounded p-1 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors">
        <%= icon("trash2", classes: "h-3.5 w-3.5") %>
      </button>
    </div>
  </template>
<% end %>
