<% content_for :page_actions do %>
  <button class="inline-flex items-center justify-center rounded-md border border-border bg-card text-sm font-medium h-9 px-3 hover:bg-surface-hover transition-colors">
    <%= icon("file_text", classes: "mr-2 h-4 w-4") %>
    Exportar
  </button>
<% end %>

<%= render "shared/page_header", title: "Historial de Ingesta", description: "Documentos y presupuestos indexados en el sistema RAG" %>

<%# Search %>
<div class="mb-4">
  <%= form_with url: documents_path, method: :get, data: { turbo_frame: "documents_table" }, class: "relative max-w-sm" do %>
    <div class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
      <%= icon("search", classes: "h-4 w-4") %>
    </div>
    <label for="search_documents" class="sr-only">Buscar documentos</label>
    <input
      id="search_documents"
      type="text"
      name="q"
      value="<%= params[:q] %>"
      placeholder="Buscar documentos..."
      class="flex h-10 w-full rounded-md border border-border bg-surface px-3 py-2 pl-10 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
    />
  <% end %>
</div>

<%= turbo_frame_tag "documents_table" do %>
  <% if @documents.any? %>
    <%# Mobile cards %>
    <div class="space-y-3 sm:hidden">
      <% @documents.each do |doc| %>
        <div class="rounded-xl border border-border bg-card p-4">
          <div class="flex items-start justify-between gap-2 mb-2">
            <p class="text-sm font-medium text-card-foreground"><%= doc.title %></p>
            <%= render "shared/status_badge", status: doc.status %>
          </div>
          <div class="flex flex-wrap gap-1 mb-2">
            <% techs = doc.technologies.is_a?(Array) ? doc.technologies : [] %>
            <% techs.first(3).each do |t| %>
              <span class="rounded bg-secondary px-1.5 py-0.5 text-[10px] font-mono text-secondary-foreground"><%= t %></span>
            <% end %>
          </div>
          <div class="flex items-center justify-between text-xs text-muted-foreground">
            <span class="font-mono"><%= doc.chunks_count %> chunks</span>
            <span class="font-mono"><%= doc.budget ? "#{number_with_delimiter(doc.budget.to_i)}€" : "—" %></span>
          </div>
          <div class="mt-3 flex items-center gap-2">
            <%= link_to document_path(doc), class: "inline-flex items-center gap-1 rounded px-2 py-1 text-xs text-muted-foreground hover:bg-surface-hover hover:text-card-foreground transition-colors", aria: { label: "Ver #{doc.title}" } do %>
              <%= icon("eye", classes: "h-3.5 w-3.5") %> Ver
            <% end %>
            <%= button_to document_path(doc), method: :delete, class: "inline-flex items-center gap-1 rounded px-2 py-1 text-xs text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors", data: { turbo_confirm: "¿Estás seguro de que deseas eliminar '#{doc.title}'?" }, aria: { label: "Eliminar #{doc.title}" } do %>
              <%= icon("trash2", classes: "h-3.5 w-3.5") %> Eliminar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Desktop table %>
    <div class="rounded-xl border border-border bg-card overflow-hidden hidden sm:block">
      <%# Header %>
      <div class="grid grid-cols-[1fr_100px_80px_100px_120px_80px] gap-2 border-b border-border bg-surface px-5 py-2.5 text-xs font-medium text-muted-foreground uppercase tracking-wider">
        <span>Proyecto</span>
        <span>Estado</span>
        <span>Chunks</span>
        <span class="text-right">Presupuesto</span>
        <span>Duración</span>
        <span></span>
      </div>

      <%# Rows %>
      <div class="divide-y divide-border">
        <% @documents.each do |doc| %>
          <div class="grid grid-cols-[1fr_100px_80px_100px_120px_80px] gap-2 items-center px-5 py-3 hover:bg-surface transition-colors">
            <div class="min-w-0">
              <p class="text-sm text-card-foreground truncate"><%= doc.title %></p>
              <div class="flex flex-wrap gap-1 mt-1">
                <% techs = doc.technologies.is_a?(Array) ? doc.technologies : [] %>
                <% techs.first(3).each do |t| %>
                  <span class="rounded bg-secondary px-1.5 py-0.5 text-[10px] font-mono text-secondary-foreground"><%= t %></span>
                <% end %>
                <% if techs.length > 3 %>
                  <span class="text-[10px] text-muted-foreground">+<%= techs.length - 3 %></span>
                <% end %>
              </div>
            </div>
            <div>
              <%= render "shared/status_badge", status: doc.status %>
            </div>
            <span class="text-sm font-mono text-muted-foreground"><%= doc.chunks_count %></span>
            <span class="text-sm font-mono text-card-foreground text-right"><%= doc.budget ? "#{number_with_delimiter(doc.budget.to_i)}€" : "—" %></span>
            <span class="text-xs text-muted-foreground"><%= doc.duration || "—" %></span>
            <div class="flex items-center gap-1">
              <%= link_to document_path(doc), class: "rounded p-1.5 text-muted-foreground hover:bg-surface-hover hover:text-card-foreground transition-colors", aria: { label: "Ver #{doc.title}" } do %>
                <%= icon("eye", classes: "h-3.5 w-3.5") %>
              <% end %>
              <%= button_to document_path(doc), method: :delete, class: "rounded p-1.5 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors", data: { turbo_confirm: "¿Estás seguro de que deseas eliminar '#{doc.title}'?" }, aria: { label: "Eliminar #{doc.title}" } do %>
                <%= icon("trash2", classes: "h-3.5 w-3.5") %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%# Empty state %>
    <div class="rounded-xl border border-dashed border-border bg-card p-10 text-center">
      <%= icon("file_text", classes: "h-10 w-10 text-muted-foreground mx-auto mb-3") %>
      <p class="text-sm font-medium text-card-foreground mb-1">No hay documentos todavía</p>
      <p class="text-xs text-muted-foreground mb-4">Ingesta tu primer presupuesto para alimentar el sistema RAG</p>
      <%= link_to ingest_path, class: "inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium h-9 px-4 hover:bg-primary/90 transition-colors" do %>
        <%= icon("upload", classes: "mr-2 h-4 w-4") %> Ingestar primer documento
      <% end %>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <nav class="mt-6 flex items-center justify-center gap-1" aria-label="Paginación">
      <% if @pagy.prev %>
        <%= link_to documents_path(page: @pagy.prev, q: params[:q]), data: { turbo_frame: "documents_table" }, class: "inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-sm hover:bg-surface-hover transition-colors" do %>
          <%= icon("arrow_left", classes: "h-4 w-4") %>
        <% end %>
      <% else %>
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-sm opacity-50 cursor-not-allowed">
          <%= icon("arrow_left", classes: "h-4 w-4") %>
        </span>
      <% end %>

      <% @pagy.series.each do |item| %>
        <% if item == :gap %>
          <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-muted-foreground">&hellip;</span>
        <% elsif item.is_a?(String) %>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-medium"><%= item %></span>
        <% else %>
          <%= link_to item, documents_path(page: item, q: params[:q]), data: { turbo_frame: "documents_table" }, class: "inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-sm hover:bg-surface-hover transition-colors" %>
        <% end %>
      <% end %>

      <% if @pagy.next %>
        <%= link_to documents_path(page: @pagy.next, q: params[:q]), data: { turbo_frame: "documents_table" }, class: "inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-sm hover:bg-surface-hover transition-colors" do %>
          <%= icon("arrow_right", classes: "h-4 w-4") %>
        <% end %>
      <% else %>
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-sm opacity-50 cursor-not-allowed">
          <%= icon("arrow_right", classes: "h-4 w-4") %>
        </span>
      <% end %>
    </nav>
  <% end %>
<% end %>
