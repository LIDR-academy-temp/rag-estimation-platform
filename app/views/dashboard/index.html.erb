<%= render "shared/page_header", title: "Dashboard", description: "Resumen del estado del servicio RAG de estimaciones" %>

<% if @health_status&.dig("status") == "unavailable" %>
  <div class="mb-6 rounded-xl border border-destructive/30 bg-destructive/10 p-4 flex items-center gap-3" role="alert">
    <%= icon("alert_triangle", classes: "h-5 w-5 text-destructive shrink-0") %>
    <div>
      <p class="text-sm font-medium text-destructive">Servicio RAG no disponible</p>
      <p class="text-xs text-destructive/80">Las funciones de búsqueda, ingesta y estimación pueden no estar operativas.</p>
    </div>
  </div>
<% end %>

<%# Stats %>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 stagger-children">
  <%= render "shared/stat_card",
    title: "Documentos",
    value: @documents_count,
    subtitle: "#{@completed_count} indexados",
    icon_name: "file_text",
    variant: "primary" %>
  <%= render "shared/stat_card",
    title: "Chunks totales",
    value: number_with_delimiter(@chunks_total),
    subtitle: "5 tipos de fragmentos",
    icon_name: "layers" %>
  <%= render "shared/stat_card",
    title: "Búsquedas (30d)",
    value: @search_metrics[:total] > 0 ? number_with_delimiter(@search_metrics[:total]) : "N/A",
    icon_name: "search" %>
  <%= render "shared/stat_card",
    title: "Latencia media",
    value: @search_metrics[:avg_latency] > 0 ? "#{@search_metrics[:avg_latency].round(0)}ms" : "N/A",
    subtitle: "P50 búsqueda semántica",
    icon_name: "clock",
    variant: "success" %>
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3 stagger-children">
  <%# Health %>
  <%= turbo_frame_tag "dashboard_health" do %>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="flex items-center gap-2 mb-4">
        <%= icon("heart", classes: "h-4 w-4 text-success") %>
        <h2 class="text-sm font-semibold text-card-foreground">Estado del sistema</h2>
        <%= render "shared/status_badge", status: @health_status&.dig("status") || "unavailable" %>
      </div>
      <div class="space-y-3">
        <% if @health_status&.dig("dependencies").present? %>
          <% @health_status["dependencies"].each do |name, info| %>
            <%
              dep_status = info.is_a?(Hash) ? info["status"] : info.to_s
              dep_latency = info.is_a?(Hash) ? info["latency_ms"] : nil
              dot_color = dep_status == "healthy" ? "bg-success" : "bg-destructive"
            %>
            <div class="flex items-center justify-between rounded-lg bg-surface p-3">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full <%= dot_color %>" aria-hidden="true"></span>
                <span class="text-sm text-card-foreground"><%= name.humanize %></span>
              </div>
              <% if dep_latency %>
                <span class="text-xs font-mono text-muted-foreground"><%= dep_latency.round(1) %>ms</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="flex items-center justify-between rounded-lg bg-surface p-3">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-muted-foreground" aria-hidden="true"></span>
              <span class="text-sm text-muted-foreground">Servicio RAG - No disponible</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Chunk distribution %>
  <%= turbo_frame_tag "dashboard_chunks" do %>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="flex items-center gap-2 mb-4">
        <%= icon("database", classes: "h-4 w-4 text-primary") %>
        <h2 class="text-sm font-semibold text-card-foreground">Distribución de chunks</h2>
      </div>

      <% total = @chunk_distribution.sum { |c| c[:count] } %>
      <%# Visual bar %>
      <div class="flex h-3 overflow-hidden rounded-full mb-4" role="img" aria-label="Distribución de chunks por tipo">
        <% @chunk_distribution.each do |c| %>
          <div class="<%= c[:color] %>" style="width: <%= total > 0 ? (c[:count].to_f / total * 100).round(1) : 0 %>%"></div>
        <% end %>
      </div>

      <div class="space-y-2">
        <% @chunk_distribution.each do |c| %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full <%= c[:color] %>" aria-hidden="true"></span>
              <span class="text-muted-foreground font-mono text-xs"><%= c[:type] %></span>
            </div>
            <span class="font-mono text-xs text-card-foreground"><%= number_with_delimiter(c[:count]) %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Recent ingestions %>
  <%= turbo_frame_tag "dashboard_recent" do %>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="flex items-center gap-2 mb-4">
        <%= icon("zap", classes: "h-4 w-4 text-warning") %>
        <h2 class="text-sm font-semibold text-card-foreground">Ingestas recientes</h2>
      </div>
      <div class="space-y-2">
        <% if @recent_documents.any? %>
          <% @recent_documents.each do |doc| %>
            <div class="flex items-center justify-between rounded-lg bg-surface p-3">
              <div class="min-w-0 flex-1">
                <p class="text-sm text-card-foreground truncate"><%= doc.title %></p>
                <p class="text-[11px] text-muted-foreground">
                  <% if doc.status == "completed" %>
                    <%= doc.chunks_count %> chunks
                  <% elsif doc.status == "processing" %>
                    Procesando...
                  <% else %>
                    Error
                  <% end %>
                  &middot; <%= time_ago_in_words(doc.created_at) %>
                </p>
              </div>
              <%= render "shared/status_badge", status: doc.status %>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-lg bg-surface p-4 text-center">
            <p class="text-sm text-muted-foreground">No hay ingestas recientes</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
