#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Install/verify gems (ensures bundle_cache volume is populated)
bundle install

# Prepare database (create if missing + run pending migrations)
# In development: always run. In production: only when launching the rails server.
if [ "$RAILS_ENV" != "production" ] || { [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; }; then
  ./bin/rails db:prepare
fi

exec "${@}"
